{
  "expo": {
    "name": "DermaLens",
    "slug": "skin-xai-mobile",
    "newArchEnabled": false,
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skinxaimobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dermalens.app",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "DermaLens uses your photo library so you can choose a skin image for visual insight.",
          "cameraPermission": "DermaLens uses your camera so you can take a skin image for visual insight.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#F4F9FB",
            "cropToolbarIconColor": "#1261A0",
            "cropToolbarActionTextColor": "#1261A0",
            "cropBackButtonIconColor": "#1261A0",
            "cropBackgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DermaLens uses your camera so you can capture a focused skin image."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F9FB",
          "imageWidth": 449,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fec7ecb7-f868-42f9-98fe-5bf5fec1efbb"
      }
    }
  }
}
